{
  "name": "llm-as-judge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "judge": "node --import tsx src/cli.ts",
    "judge:batch": "python3 scripts/evaluateCsvBatch.py",
    "lint": "eslint src && tsc --noEmit",
    "lint:fix": "eslint src --fix && tsc --noEmit",
    "lint:strict": "eslint src --max-warnings=0 && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@schmiedmayerlab/grove-configurations": "^0.1.1",
    "@types/node": "^26",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
